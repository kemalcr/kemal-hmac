#!/bin/bash

source script/setup-env "$@"

test_dir=$(mktemp -d)
server_pid=""
cleanup() {
  if [[ -n "$server_pid" ]]; then
    # Signal Bash's own background job even if the server exited early.
    kill %% 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
  fi
  rm -rf "$test_dir"
}
trap cleanup EXIT

echo -e "🚀 ${BLUE}starting the server${OFF}"
crystal build script/acceptance_tests/server.cr --exclude-warnings "$SHARDS_INSTALL_PATH" -o "$test_dir/server"
ACCEPTANCE_SERVER_PORT_FILE="$test_dir/port" "$test_dir/server" >"$test_dir/server.log" 2>&1 &
server_pid=$!

echo -e "⏳ ${BLUE}waiting for the server to be ready${OFF}"
for ((attempt = 0; attempt < 100; attempt++)); do
  if [[ -s "$test_dir/port" ]] || ! kill -0 "$server_pid" 2>/dev/null; then
    break
  fi
  sleep 0.1
done
if [[ ! -s "$test_dir/port" ]] || ! kill -0 "$server_pid" 2>/dev/null; then
  cat "$test_dir/server.log" >&2
  echo "Acceptance server failed to start" >&2
  exit 1
fi

echo -e "🧪 ${BLUE}running the acceptance tests${OFF}"
crystal build script/acceptance_tests/tests.cr --exclude-warnings "$SHARDS_INSTALL_PATH" -o "$test_dir/tests"
if ! ACCEPTANCE_TEST_PORT=$(cat "$test_dir/port") "$test_dir/tests"; then
  cat "$test_dir/server.log" >&2
  exit 1
fi
